//! Integration tests for team collaboration functionality
//!\n//! These tests verify that the team collaboration tools work correctly\n//! using the new async function executor pattern.\n\nuse commune::prelude::*;\nuse serde_json::json;\nuse std::{collections::HashMap, sync::Arc};\nuse tokio::time::{sleep, Duration};\n\n/// Helper function to execute a tool (simulating MCP framework behavior)\nasync fn execute_tool(tool: &Tool, params: Option<serde_json::Value>) -> Result<MessageContent, Error> {\n    match tool {\n        Tool::Local { executor, .. } => {\n            match executor {\n                Executor::Fn(func) => {\n                    func(params).await\n                }\n                Executor::Cmd { .. } => {\n                    Err(Error::InvalidInput(\"Command execution not supported in tests\".to_string()))\n                }\n            }\n        }\n        Tool::Remote { .. } => {\n            Err(Error::InvalidInput(\"Remote tool execution not supported in tests\".to_string()))\n        }\n    }\n}\n\n#[tokio::test]\nasync fn test_ask_member_tool_basic_functionality() {\n    // Setup\n    let team_id = \"test_team\".to_string();\n    let mut team_members = HashMap::new();\n    team_members.insert(\"alice\".to_string(), \"Alice (Developer)\".to_string());\n    team_members.insert(\"bob\".to_string(), \"Bob (Designer)\".to_string());\n    \n    let task_tracker = Arc::new(TaskTracker::new());\n    \n    let ask_member_tool = create_ask_member_tool(\n        team_id,\n        team_members,\n        Arc::clone(&task_tracker),\n        5, // max concurrent tasks\n        60, // task timeout seconds\n    );\n    \n    // Test valid member request\n    let params = json!({\n        \"member_id\": \"alice\",\n        \"message\": \"Please review the authentication module\"\n    });\n    \n    let result = execute_tool(&ask_member_tool, Some(params)).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Task Delegated Successfully\"));\n        assert!(text.contains(\"alice\"));\n    } else {\n        panic!(\"Expected text message content\");\n    }\n    \n    // Verify task was created\n    let pending_tasks = task_tracker.get_pending_tasks().await;\n    assert_eq!(pending_tasks.len(), 1);\n    assert_eq!(pending_tasks[0].member_id, \"alice\");\n    assert_eq!(pending_tasks[0].message, \"Please review the authentication module\");\n}\n\n#[tokio::test]\nasync fn test_ask_member_tool_invalid_member() {\n    // Setup\n    let team_id = \"test_team\".to_string();\n    let team_members = HashMap::from([\n        (\"alice\".to_string(), \"Alice (Developer)\".to_string())\n    ]);\n    \n    let task_tracker = Arc::new(TaskTracker::new());\n    \n    let ask_member_tool = create_ask_member_tool(\n        team_id,\n        team_members,\n        Arc::clone(&task_tracker),\n        5,\n        60,\n    );\n    \n    // Test invalid member request\n    let params = json!({\n        \"member_id\": \"nonexistent\",\n        \"message\": \"Some task\"\n    });\n    \n    let result = execute_tool(&ask_member_tool, Some(params)).await;\n    assert!(result.is_err());\n    \n    if let Err(Error::InvalidInput(msg)) = result {\n        assert!(msg.contains(\"not part of team\"));\n        assert!(msg.contains(\"nonexistent\"));\n    } else {\n        panic!(\"Expected InvalidInput error\");\n    }\n    \n    // Verify no task was created\n    let pending_tasks = task_tracker.get_pending_tasks().await;\n    assert_eq!(pending_tasks.len(), 0);\n}\n\n#[tokio::test]\nasync fn test_ask_members_tool_concurrent_tasks() {\n    // Setup\n    let team_id = \"dev_team\".to_string();\n    let team_members = HashMap::from([\n        (\"alice\".to_string(), \"Alice (Backend)\".to_string()),\n        (\"bob\".to_string(), \"Bob (Frontend)\".to_string()),\n        (\"charlie\".to_string(), \"Charlie (DevOps)\".to_string()),\n    ]);\n    \n    let task_tracker = Arc::new(TaskTracker::new());\n    \n    let ask_members_tool = create_ask_members_tool(\n        team_id,\n        team_members,\n        Arc::clone(&task_tracker),\n        10, // max concurrent tasks\n        120, // task timeout seconds\n    );\n    \n    // Test concurrent task assignment\n    let params = json!({\n        \"member_tasks\": {\n            \"alice\": \"Implement user authentication\",\n            \"bob\": \"Design the login UI\",\n            \"charlie\": \"Set up database migrations\"\n        }\n    });\n    \n    let result = execute_tool(&ask_members_tool, Some(params)).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Concurrent Tasks Delegated Successfully\"));\n        assert!(text.contains(\"3 tasks\"));\n    } else {\n        panic!(\"Expected text message content\");\n    }\n    \n    // Verify all tasks were created\n    let pending_tasks = task_tracker.get_pending_tasks().await;\n    assert_eq!(pending_tasks.len(), 3);\n    \n    // Verify task content\n    let alice_task = pending_tasks.iter().find(|t| t.member_id == \"alice\").unwrap();\n    assert_eq!(alice_task.message, \"Implement user authentication\");\n    \n    let bob_task = pending_tasks.iter().find(|t| t.member_id == \"bob\").unwrap();\n    assert_eq!(bob_task.message, \"Design the login UI\");\n    \n    let charlie_task = pending_tasks.iter().find(|t| t.member_id == \"charlie\").unwrap();\n    assert_eq!(charlie_task.message, \"Set up database migrations\");\n}\n\n#[tokio::test]\nasync fn test_poll_task_tool_lifecycle() {\n    // Setup\n    let task_tracker = Arc::new(TaskTracker::new());\n    let poll_task_tool = create_poll_task_tool(Arc::clone(&task_tracker));\n    \n    // Create a task manually\n    let task = TeamMemberTask {\n        task_id: \"test_task_123\".to_string(),\n        member_id: \"alice\".to_string(),\n        message: \"Test task\".to_string(),\n        conversation_id: Some(\"conv_1\".to_string()),\n        created_at: std::time::Instant::now(),\n        timeout: Duration::from_secs(60),\n    };\n    \n    task_tracker.submit_task(task).await.unwrap();\n    \n    // Test polling pending task\n    let poll_params = json!({\n        \"task_id\": \"test_task_123\"\n    });\n    \n    let result = execute_tool(&poll_task_tool, Some(poll_params.clone())).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Task Status: Pending\"));\n        assert!(text.contains(\"test_task_123\"));\n    } else {\n        panic!(\"Expected text message content\");\n    }\n    \n    // Start the task\n    task_tracker.start_task(\"test_task_123\").await.unwrap();\n    \n    // Test polling in-progress task\n    let result = execute_tool(&poll_task_tool, Some(poll_params.clone())).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Task Status: In Progress\"));\n    }\n    \n    // Complete the task\n    let response = TeamMemberResponse {\n        task_id: \"test_task_123\".to_string(),\n        member_id: \"alice\".to_string(),\n        response: \"Task completed successfully!\".to_string(),\n        success: true,\n        error: None,\n        duration_ms: 2500,\n    };\n    \n    task_tracker.complete_task(response).await.unwrap();\n    \n    // Test polling completed task\n    let result = execute_tool(&poll_task_tool, Some(poll_params)).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Task Status: Completed\"));\n        assert!(text.contains(\"Task completed successfully!\"));\n        assert!(text.contains(\"2500ms\"));\n    } else {\n        panic!(\"Expected text message content\");\n    }\n}\n\n#[tokio::test]\nasync fn test_poll_task_tool_nonexistent_task() {\n    let task_tracker = Arc::new(TaskTracker::new());\n    let poll_task_tool = create_poll_task_tool(task_tracker);\n    \n    let poll_params = json!({\n        \"task_id\": \"nonexistent_task\"\n    });\n    \n    let result = execute_tool(&poll_task_tool, Some(poll_params)).await;\n    assert!(result.is_err());\n    \n    if let Err(Error::InvalidInput(msg)) = result {\n        assert!(msg.contains(\"not found\"));\n        assert!(msg.contains(\"nonexistent_task\"));\n    } else {\n        panic!(\"Expected InvalidInput error\");\n    }\n}\n\n#[tokio::test]\nasync fn test_task_tracker_concurrent_limit() {\n    let team_id = \"test_team\".to_string();\n    let team_members = HashMap::from([\n        (\"alice\".to_string(), \"Alice\".to_string()),\n        (\"bob\".to_string(), \"Bob\".to_string()),\n    ]);\n    \n    let task_tracker = Arc::new(TaskTracker::new());\n    let max_concurrent = 2;\n    \n    let ask_member_tool = create_ask_member_tool(\n        team_id,\n        team_members,\n        Arc::clone(&task_tracker),\n        max_concurrent,\n        60,\n    );\n    \n    // Submit tasks up to the limit\n    for i in 0..max_concurrent {\n        let params = json!({\n            \"member_id\": \"alice\",\n            \"message\": format!(\"Task {}\", i)\n        });\n        \n        let result = execute_tool(&ask_member_tool, Some(params)).await;\n        assert!(result.is_ok(), \"Task {} should have been accepted\", i);\n    }\n    \n    // Try to submit one more task - should fail\n    let params = json!({\n        \"member_id\": \"bob\",\n        \"message\": \"Task that should fail\"\n    });\n    \n    let result = execute_tool(&ask_member_tool, Some(params)).await;\n    assert!(result.is_err());\n    \n    if let Err(Error::InvalidInput(msg)) = result {\n        assert!(msg.contains(\"Max concurrent tasks reached\"));\n    } else {\n        panic!(\"Expected InvalidInput error for concurrent limit\");\n    }\n    \n    // Verify only max_concurrent tasks exist\n    let pending_tasks = task_tracker.get_pending_tasks().await;\n    assert_eq!(pending_tasks.len(), max_concurrent);\n}\n\n#[tokio::test]\nasync fn test_task_tracker_statistics() {\n    let task_tracker = Arc::new(TaskTracker::new());\n    \n    // Create and complete some tasks\n    let tasks = vec![\n        (\"task1\", \"alice\", true, 1000u64),\n        (\"task2\", \"bob\", false, 2000u64),\n        (\"task3\", \"charlie\", true, 1500u64),\n    ];\n    \n    for (task_id, member_id, success, duration) in tasks {\n        // Create task\n        let task = TeamMemberTask {\n            task_id: task_id.to_string(),\n            member_id: member_id.to_string(),\n            message: \"Test task\".to_string(),\n            conversation_id: None,\n            created_at: std::time::Instant::now(),\n            timeout: Duration::from_secs(60),\n        };\n        \n        task_tracker.submit_task(task).await.unwrap();\n        task_tracker.start_task(task_id).await.unwrap();\n        \n        // Complete task\n        let response = TeamMemberResponse {\n            task_id: task_id.to_string(),\n            member_id: member_id.to_string(),\n            response: if success { \"Success\".to_string() } else { \"\".to_string() },\n            success,\n            error: if success { None } else { Some(\"Test error\".to_string()) },\n            duration_ms: duration,\n        };\n        \n        task_tracker.complete_task(response).await.unwrap();\n    }\n    \n    // Check statistics\n    let (pending, in_progress, completed, failed, avg_time) = task_tracker.get_stats().await;\n    \n    assert_eq!(pending, 0);\n    assert_eq!(in_progress, 0);\n    assert_eq!(completed, 2); // task1 and task3 succeeded\n    assert_eq!(failed, 1); // task2 failed\n    assert_eq!(avg_time, 1500.0); // (1000 + 2000 + 1500) / 3\n}\n\n#[tokio::test]\nasync fn test_team_tools_integration() {\n    // This test demonstrates a full workflow using multiple team tools\n    let team_id = \"integration_team\".to_string();\n    let team_members = HashMap::from([\n        (\"alice\".to_string(), \"Alice (Lead)\".to_string()),\n        (\"bob\".to_string(), \"Bob (Dev)\".to_string()),\n    ]);\n    \n    let task_tracker = Arc::new(TaskTracker::new());\n    \n    // Create all tools\n    let ask_member_tool = create_ask_member_tool(\n        team_id.clone(),\n        team_members.clone(),\n        Arc::clone(&task_tracker),\n        5,\n        120,\n    );\n    \n    let ask_members_tool = create_ask_members_tool(\n        team_id,\n        team_members,\n        Arc::clone(&task_tracker),\n        5,\n        120,\n    );\n    \n    let poll_task_tool = create_poll_task_tool(Arc::clone(&task_tracker));\n    \n    // Step 1: Assign a single task\n    let single_task_params = json!({\n        \"member_id\": \"alice\",\n        \"message\": \"Lead the project initialization\"\n    });\n    \n    let result = execute_tool(&ask_member_tool, Some(single_task_params)).await;\n    assert!(result.is_ok());\n    \n    // Step 2: Assign multiple tasks\n    let multi_task_params = json!({\n        \"member_tasks\": {\n            \"bob\": \"Set up the development environment\"\n        }\n    });\n    \n    let result = execute_tool(&ask_members_tool, Some(multi_task_params)).await;\n    assert!(result.is_ok());\n    \n    // Step 3: Check that we have 2 pending tasks\n    let pending_tasks = task_tracker.get_pending_tasks().await;\n    assert_eq!(pending_tasks.len(), 2);\n    \n    // Step 4: Simulate task completion and polling\n    let alice_task = pending_tasks.iter().find(|t| t.member_id == \"alice\").unwrap();\n    let alice_task_id = alice_task.task_id.clone();\n    \n    // Complete Alice's task\n    task_tracker.start_task(&alice_task_id).await.unwrap();\n    \n    let alice_response = TeamMemberResponse {\n        task_id: alice_task_id.clone(),\n        member_id: \"alice\".to_string(),\n        response: \"Project initialized successfully with proper structure\".to_string(),\n        success: true,\n        error: None,\n        duration_ms: 3000,\n    };\n    \n    task_tracker.complete_task(alice_response).await.unwrap();\n    \n    // Step 5: Poll for Alice's task status\n    let poll_params = json!({\n        \"task_id\": alice_task_id\n    });\n    \n    let result = execute_tool(&poll_task_tool, Some(poll_params)).await;\n    assert!(result.is_ok());\n    \n    if let Ok(MessageContent::Text { text }) = result {\n        assert!(text.contains(\"Task Status: Completed\"));\n        assert!(text.contains(\"Project initialized successfully\"));\n    }\n    \n    // Step 6: Verify final state\n    let (pending, in_progress, completed, failed, avg_time) = task_tracker.get_stats().await;\n    assert_eq!(pending, 1); // Bob's task still pending\n    assert_eq!(in_progress, 0);\n    assert_eq!(completed, 1); // Alice's task completed\n    assert_eq!(failed, 0);\n    assert_eq!(avg_time, 3000.0);\n}\n